# MAA 运行产物
debug/
vendor/

# 本机参数 (adb 路径/端口), 不随仓库分发
config.json

# 一次性迁移脚本
tools/_patch_git.py

# 内嵌第三方仓库 (Skullgirls 图鉴, 可选本地克隆: https://github.com/Krazete/sgm)
sgm/
!tools/static/icons/sgm/
!tools/static/icons/sgm/**

# Generated browser screenshots
/tests/artifacts/

# 安卓小组件工程 (独立打包 APK, 不随脚本仓库分发)
pfwidget/

# 本机启动脚本 (内含个人 anaconda 路径; 仓库用户直接 python tools/pf_bot.py 即可)
*.bat

# 安全扫描工具历史 (mimosa)
.mimosa/

# 本机会话数据 (WorkBuddy 记忆/自动化记录) —— 不随仓库分发
.workbuddy/
.agents/

# Python
__pycache__/
*.pyc
requirements.txt.bak

# 游戏截图含账号信息 (玩家名/等级/货币), 2026-09-30 起不入库 (本地保留)
docs/explore/
docs/screenshots/

# 本机启动脚本变体 (内含个人 anaconda 路径; 同 *.bat 口径不入库)
*.vbs

# PyInstaller 产物 (托盘 exe 本地自用, 不入库)
/dist/
/build/
*.spec
/pf_tray.exe

# phone/ 本地基座(MaaTouch/settle_bot 等)本地保留, 仅 autojs/ 入库 (2026-10-01 固化, 别 git add)
/phone/*
!/phone/autojs/
# phone/app/ = 原生挂机 App (2026-10-05 起入库, 构建链复用 vendor)
!/phone/app/
