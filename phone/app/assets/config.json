     },
     {
       "from": "phase",
       "to": "battle",
       "on": "phase=0"
     },
     {
       "from": "phase",
       "to": "result",
       "on": "phase=1"
     },
     {
       "from": "battle",
       "to": "bigword",
       "on": "命中"
     },
     {
       "from": "battle",
       "to": "stall",
       "on": "未命中"
     },
     {
       "from": "bigword",
       "to": "result",
       "on": "进结算 (不盲点)"
     },
     {
       "from": "result",
       "to": "rematch",
       "on": "REMATCH 过阈"
     },
     {
       "from": "result",
       "to": "continue",
       "on": "CONTINUE 过阈"
     },
     {
       "from": "result",
       "to": "fallbk",
       "on": "两者都不过阈"
     },
     {
       "from": "rematch",
       "to": "count"
     },
     {
       "from": "continue",
       "to": "stall",
       "on": "略过这页"
     },
     {
       "from": "fallbk",
       "to": "battle",
       "on": "转回战斗"
     },
     {
       "from": "stall",
       "to": "escape"
     },
     {
       "from": "escape",
       "to": "escfb",
       "on": "全不中"
     },
     {
       "from": "escfb",
       "to": "stall"
     },
     {
       "from": "stall",
       "to": "bstl",
       "on": "phase=0"
     },
     {
       "from": "bstl",
       "to": "heal",
       "on": "连 3 次"
     },
     {
       "from": "heal",
       "to": "run"
     },
     {
       "from": "count",
       "to": "save"
     },
     {
       "from": "save",
       "to": "capend",
       "on": "达上限"
     },
     {
       "from": "save",
       "to": "run",
       "on": "未达"
     }
   ],
   "title": "SGM 结算循环 — 全程序判定图",
   "note": "阈值按 cfg 路径从当前 config 实时回填; 改了 config 图跟着变。escape 链节点由 Graph.load 按 escape.items 动态展开。"
