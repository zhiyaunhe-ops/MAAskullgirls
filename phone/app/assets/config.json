  "min_sim": 0.72,
  "ev_play": 0.78,
  "target": 0.75,
  "spd": 0.95,
  "x": 0.8,
  "modal": 0.9,
  "srv": 0.75,
  "hall": 0.72
 },
 "timing": {
  "battle_ms": 800,
  "result_ms": 350,
  "tap_delay_ms": 1200,
  "stall_sec": 30,
  "battle_stall_sec": 180,
  "launch_timeout_s": 300,
  "hub_timeout_s": 120
 },
 "scan": {
  "battle_ms": 800,
  "result_ms": 350,
  "stall_ms": 1000,
  "adaptive": {
   "on": true,
   "min_ms": 250,
   "max_ms": 2000,
   "hit_ms": 350,
   "miss_ms": 900
  }
 },
 "matcher": {
  "chan": "blue",
  "step": 2,
  "refine": 2,
  "work_h": 576,
  "pyramid": {
   "level": 2,
   "cost": 200000000,
   "relax": 0.3,
   "floor": 0.5,
   "top": 16
  }
 },
 "screen": {
  "roi_mode": "abs",
  "profiles": [
   {
    "name": "tablet_4x3",
    "ar_min": 1.2,
    "ar_max": 1.7,
    "roi_mode": "fit"
   },
   {
    "name": "std_16x9",
    "ar_min": 1.7,
    "ar_max": 2.0,
    "roi_mode": "fit"
   },
   {
    "name": "tall_20x9",
    "ar_min": 2.0,
    "ar_max": 2.5,
    "roi_mode": "abs"
   },
   {
    "name": "wide_21x9",
    "ar_min": 2.5,
    "ar_max": 3.4,
    "roi_mode": "fit"
   }
  ]
 },
 "popup": {
  "guard": true,
  "after_sec": 5,
  "every_sec": 5
 },
 "run": {
  "max_minutes": 0,
  "pause_from": "",
  "pause_to": ""
 },
 "log": {
  "trace_size": 200
 },
 "graph": {
   "layout": "lane",
   "lanes": [
     {
       "id": 0,
       "name": "开跑门槛"
     },
     {
       "id": 1,
       "name": "主循环守卫"
     },
     {
       "id": 2,
       "name": "取帧 / ROI 映射"
     },
     {
       "id": 3,
       "name": "战斗阶段 (phase 0)"
     },
     {
       "id": 4,
       "name": "结算阶段 (phase 1)"
     },
     {
       "id": 5,
       "name": "stall 逃生 / 自愈"
     },
     {
       "id": 6,
       "name": "计场与落盘"
     }
   ],
   "nodes": [
     {
       "id": "tpl",
       "label": "模板就绪",
       "kind": "guard",
       "lane": 0,
       "cond": "victory/defeat 都取到才开跑",
       "src": "assets/templates"
     },
     {
       "id": "roisc",
       "label": "模板按屏幕缩放",
       "kind": "roi",
       "lane": 0,
       "cond": "按当前屏幕取 x/y 缩放倍数",
       "cfg": "screen.roi_mode"
     },
     {
       "id": "cap0",
       "label": "每日上限",
       "kind": "guard",
       "lane": 0,
       "cond": "今日场数已达上限则不开跑",
       "cfg": "daily_cap",
       "note": "0 = 不限"
     },
     {
       "id": "run",
       "label": "循环运行中",
       "kind": "loop",
       "lane": 1,
       "cond": "run 标志为真"
     },
     {
       "id": "pause",
       "label": "夜间暂停",
       "kind": "loop",
       "lane": 1,
       "cond": "当前时间在暂停时段内则不截屏不点击",
       "cfg": "run.pause_from~pause_to",
       "note": "跨夜也支持"
     },
     {
       "id": "maxmin",
       "label": "单次最长",
       "kind": "loop",
       "lane": 1,
       "cond": "已跑超过单次上限则停",
       "cfg": "run.max_minutes",
       "note": "0 = 不限"
     },
     {
       "id": "shot",
       "label": "截屏",
       "kind": "scan",
       "lane": 2,
       "cond": "Shizuku shell 截屏; 失败下一轮重试"
     },
     {
       "id": "roimap",
       "label": "ROI 多分辨率映射",
       "kind": "roi",
       "lane": 2,
       "cond": "work 宽高变了才重算 ROI",
       "cfg": "screen.profiles",
       "note": "abs/center/rel/fit 四选一"
     },
     {
       "id": "popup",
       "label": "弹窗守卫",
       "kind": "chain",
       "lane": 2,
       "cond": "距上次动作 > after_sec 就周期性剥弹窗 (任何相位都跑)",
       "cfg": "popup.after_sec",
       "note": "间隔 every_sec; guard=false 可关。JS 版这条逻辑在 pf_nav.waitHall 里每帧跑, 这里挂在结算循环上 (没有导航链)"
     },
     {
       "id": "phase",
       "label": "相位选择",
       "kind": "branch",
       "lane": 2,
       "cond": "phase==0 走战斗监测, 否则走结算页"
     },
     {
       "id": "battle",
       "label": "战斗监测",
       "kind": "scan",
       "lane": 3,
       "cond": "在 title_roi 内查 VICTORY/DEFEAT 大字",
       "cfg": "thresholds.min_sim",
       "roi": "title_roi",
       "tpl": [
         "victory",
         "defeat"
       ]
     },
     {
       "id": "bigword",
       "label": "大字出现",
       "kind": "match",
       "lane": 3,
       "cond": "见到大字 → 记胜负(本局首次)并转结算; 点哪个按钮交给 phase 1 匹配",
       "note": "大字不计场, 计场在 phase 1 点 REMATCH 那一刻"
     },
     {
       "id": "result",
       "label": "结算页",
       "kind": "scan",
       "lane": 4,
       "cond": "在 btn_rois 三槽内查 REMATCH/CONTINUE",
       "cfg": "thresholds.min_sim",
       "roi": "btn_rois",
       "tpl": [
         "btn_rematch",
         "btn_continue"
       ]
     },
     {
       "id": "rematch",
       "label": "REMATCH 命中",
       "kind": "tap",
       "lane": 4,
       "cond": "REMATCH 峰值过阈 → 点它并计一场",
       "note": "一局恰计一次"
     },
     {
       "id": "continue",
       "label": "CONTINUE 命中",
       "kind": "tap",
       "lane": 4,
       "cond": "CONTINUE 峰值过阈 → 点它略过这一页",
       "note": "留在结算阶段, 可能还有下一页"
     },
     {
       "id": "fallbk",
       "label": "连续未命中",
       "kind": "heal",
       "lane": 4,
       "cond": "连续无命中到上限 → 转回战斗监测",
       "cfg": "result_fallback"
     },
     {
       "id": "stall",
       "label": "无动作超时",
       "kind": "heal",
       "lane": 5,
       "cond": "距上次有效动作超过阈值 → 走逃生链",
       "cfg": "timing.stall_sec"
     },
     {
       "id": "escape",
       "label": "弹窗逃生链",
       "kind": "chain",
       "lane": 5,
       "cond": "按配置顺序逐个试; 命中即点",
       "expand": "escape",
       "note": "每项的 th 各不相同, 见链上标注"
     },
     {
       "id": "escfb",
       "label": "三槽兜底",
       "kind": "heal",
       "lane": 5,
       "cond": "链上全不中 → 用结算按钮位置兜底点一下",
       "cfg": "btn_rois"
     },
     {
       "id": "bstl",
       "label": "战斗超时",
       "kind": "heal",
       "lane": 5,
       "cond": "入战斗起超过阈值仍无结果 → 计一次超时跳",
       "cfg": "timing.battle_stall_sec"
     },
     {
       "id": "heal",
       "label": "自愈",
       "kind": "heal",
       "lane": 5,
       "cond": "连续 3 次同类超时 → selfHeal()",
       "note": "PLAY 拉回待 NavChain (M2), 缺它不盲点"
     },
     {
       "id": "count",
       "label": "计一场",
       "kind": "count",
       "lane": 6,
       "cond": "胜负按上一局记下的 VICTORY/DEFEAT"
     },
     {
       "id": "save",
       "label": "落盘",
       "kind": "count",
       "lane": 6,
       "cond": "每场写完 store.json — 崩溃/被杀不丢"
     },
     {
       "id": "capend",
       "label": "到上限停车",
       "kind": "guard",
       "lane": 6,
       "cond": "计完这场打到上限 → run=false"
     }
   ],
   "edges": [
     {
       "from": "tpl",
       "to": "roisc"
     },
     {
       "from": "roisc",
       "to": "cap0"
     },
