<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zhiyaunhe.sgmbot"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14 (targetSdk 34): foregroundServiceType="specialUse" 必须同时持有此权限
         并在 service 下声明 <property> 用途, 否则 startForeground 抛 SecurityException
         (实测: Service 直接创建失败, 循环永远起不来) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Shizuku: server 的 BinderSender 只向声明了此权限的包推送 binder
         (sendBinder 里 requestedPermissions 不含 API_V23 的包被直接 continue),
         缺了它 provider 永远收不到 binder, 表现为"Shizuku 永远未连接"。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
    <!-- 分区存储 (Android 11+): /sdcard 根目录只有"所有文件访问"能读写。
         未授时 Paths 自动退到 App 私有外部目录, 功能不残但 adb push 得写长路径。
         授权入口: 主页按「授权所有文件访问」跳系统设置页。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- APK 自更新第二条路: Shizuku(pm install) 装不上时改把系统安装界面弹出来让用户点。
         API 26+ 必须声明此权限, 否则 canRequestPackageInstalls() 恒 false、安装界面被系统直接拒。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:name=".App"
        android:label="SGM挂机"
        android:icon="@drawable/ic_bot"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 配置编辑页 (只暴露调不坏的安全子集; 写 override 文件 + 热重载) -->
        <activity android:name=".ConfigActivity" android:exported="false"/>

        <!-- 判定路径图: App 内 Canvas 自绘 (2026-10-11 起不再内嵌 WebView 开 8791)。
             几何在 GraphLayout.java, 绘制在 GraphView.java; PC 网页版仍在 /graph -->
        <activity android:name=".GraphActivity" android:exported="false"/>

        <!-- 使用指引: Shizuku 官方下载链接 + 开发者模式/无线调试 6 步开启流程 + 没反应速查表 -->
        <activity android:name=".HelpActivity" android:exported="false"/>

        <!-- 每日战绩: GitHub contributions 风格热力图 + 每日明细 + 口径说明 -->
        <activity android:name=".StatsActivity" android:exported="false"/>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.zhiyaunhe.sgmbot.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <!-- 只读地把自己下载的 APK 递给系统安装器 (content:// 那条路, 见 ApkProvider)。
             exported=false + grantUriPermissions=true: 不对外开口子, 靠 intent 上的一次性
             读权限把单个文件借给安装器。authority 必须与 ApkFile.AUTHORITY 一致。 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.zhiyaunhe.sgmbot.apkfile"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <service android:name=".BotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="游戏挂机自动化: Shizuku shell 截屏识别结算页并模拟点击"/>
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- adb 控制面广播通道: 未注册时 am broadcast 静默无响应 (日志连 onReceive 都没有) -->
        <receiver android:name=".CtlReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.zhiyaunhe.sgmbot.CMD"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
